# =============================================================================
# Ola_devboard environment template
# =============================================================================
# Copy this file to `.env` (top-level) and fill in the values.
# `.env` is gitignored — never commit it.
#
# v0 design: devboard binds 127.0.0.1 only. There is no auth in v0; access is
# controlled by network reachability. Production deployment is a separate
# follow-up issue (see CRM's task.md `Discovered tech debt`).
# =============================================================================

# --- MongoDB Atlas (read-only on the dashboard side) ---
# Devboard connects to the SAME Atlas database as the CRM. Use the SAME
# DATABASE string the CRM uses (or a dedicated read-only Atlas user once
# we get to prod — tracked in tech debt).
DATABASE="mongodb+srv://USER:PASS@cluster0.lf5c8.mongodb.net/mydatabase?retryWrites=true&w=majority"

# --- File system path to CRM's mcp.log ---
# The Logs panel tails this file. Devboard runs on the same machine as the
# CRM backend (v0 local-only design), so a relative-or-absolute path to the
# CRM checkout's `backend/logs/mcp.log` works.
MCP_LOG_FILE_PATH="/Users/duke/Documents/GitHub/crm/backend/logs/mcp.log"

# --- Health probe targets (loopback URLs the MCP Health panel hits) ---
MCP_HEALTH_URL="http://127.0.0.1:8889/health"
NANOBOT_SERVE_HEALTH_URL="http://127.0.0.1:8900/health"
NANOBOT_GATEWAY_HEALTH_URL="http://127.0.0.1:8901/health"

# --- Devboard own ports ---
BACKEND_PORT=8890
FRONTEND_PORT=3001

# --- Auth (Ola/#225-A: single-password session cookie) ---
# Plain-text password compared with constant-time equality on POST
# /api/auth/login. Required — backend refuses login otherwise.
DEVBOARD_PASSWORD="change-me"

# HMAC-SHA256 secret used to sign session cookies. Required, must be at
# least 16 chars. Rotate to invalidate all existing sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-min-16-chars-hex-or-base64"

# Set to 1 in prod when fronted by HTTPS (Cloudflare proxy on box4) so the
# cookie carries the Secure flag. Leave 0 for local HTTP dev.
COOKIE_SECURE=0
