# =============================================================================
# Ola_devboard environment template
# =============================================================================
# Copy this file to `.env` (top-level) and fill in the values.
# `.env` is gitignored — never commit it.
#
# v0 design: devboard binds 127.0.0.1 only. There is no auth in v0; access is
# controlled by network reachability. Production deployment is a separate
# follow-up issue (see CRM's task.md `Discovered tech debt`).
# =============================================================================

# --- MongoDB Atlas (read-only on the dashboard side) ---
# Devboard connects to the SAME Atlas database as the CRM. Use the SAME
# DATABASE string the CRM uses (or a dedicated read-only Atlas user once
# we get to prod — tracked in tech debt).
DATABASE="mongodb+srv://USER:PASS@cluster0.lf5c8.mongodb.net/mydatabase?retryWrites=true&w=majority"

# --- File system path to CRM's mcp.log ---
# The Logs panel tails this file. Devboard runs on the same machine as the
# CRM backend (v0 local-only design), so a relative-or-absolute path to the
# CRM checkout's `backend/logs/mcp.log` works.
MCP_LOG_FILE_PATH="/Users/duke/Documents/GitHub/crm/backend/logs/mcp.log"

# --- File system path to CRM's transcription.log ---
# Logs panel's `transcription` source tails this file. Written by CRM
# transcriptionWorker after each audio file is processed (job lifecycle:
# pending → running → done | failed). Unset → panel shows hint, not 500.
TRANSCRIPTION_LOG_FILE_PATH="/Users/duke/Documents/GitHub/crm/backend/logs/transcription.log"

# --- Health probe targets (loopback URLs the MCP Health panel hits) ---
MCP_HEALTH_URL="http://127.0.0.1:8889/health"
NANOBOT_SERVE_HEALTH_URL="http://127.0.0.1:8900/health"
NANOBOT_GATEWAY_HEALTH_URL="http://127.0.0.1:8901/health"

# --- Devboard own ports & bind ---
BACKEND_PORT=8890
FRONTEND_PORT=3001
# Devboard backend bind host (Ola/#225-D). Default '127.0.0.1' is the v0
# loopback red line. Set to '0.0.0.0' ONLY on box4 (or other prod hosts)
# where auth is in place AND a reverse proxy fronts HTTPS — never in local
# dev. Mis-set on a public box without auth is a data-exposure incident.
BACKEND_HOST=127.0.0.1

# --- Auth (Ola/#225-A: single-password session cookie) ---
# Plain-text password compared with constant-time equality on POST
# /api/auth/login. Required — backend refuses login otherwise.
DEVBOARD_PASSWORD="change-me"

# HMAC-SHA256 secret used to sign session cookies. Required, must be at
# least 16 chars. Rotate to invalidate all existing sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-min-16-chars-hex-or-base64"

# Set to 1 in prod when fronted by HTTPS (Cloudflare proxy on box4) so the
# cookie carries the Secure flag. Leave 0 for local HTTP dev.
COOKIE_SECURE=0

# --- Docker publish (docker-compose.yml) ---
# Where the frontend nginx (port 80 inside the container) is published on the
# HOST. Defaults are deliberately conservative so a shared box (e.g. box3,
# which already runs the PDF service) is never disturbed:
#   DEVBOARD_BIND_ADDR=127.0.0.1  -> only the box's own reverse proxy can reach
#                                    it; flip to 0.0.0.0 to expose publicly.
#   DEVBOARD_HTTP_PORT=8080       -> host port; pick one the box's other
#                                    products do NOT use (NOT 80/443 if an
#                                    existing nginx/PDF service owns those).
# On a host where this devboard is the ONLY web app, set 0.0.0.0 + 80 and let
# Cloudflare front it directly.
DEVBOARD_BIND_ADDR=127.0.0.1
DEVBOARD_HTTP_PORT=8080

# --- Persona control-plane (edit per-tenant SOUL/USER via nanobot) ---
# Each environment points at that env's nanobot persona API over Tailscale plus
# the Mongo it stores admins in (for id -> name). An env missing NANOBOT_URL or
# TOKEN is simply hidden from the picker. *_MONGO is optional — if unset, the
# default DATABASE connection above is used for name resolution.
#   prod:    Box2 Tailscale IP (100.83.72.110), prod Atlas
#   staging: Box6 Tailscale IP, dev DB
# The token MUST match that env's nanobot PERSONA_API_TOKEN.
PERSONA_PROD_NANOBOT_URL="http://100.83.72.110:8902"
PERSONA_PROD_TOKEN="change-me-match-box2-PERSONA_API_TOKEN"
PERSONA_PROD_MONGO=""
PERSONA_STAGING_NANOBOT_URL=""
PERSONA_STAGING_TOKEN=""
PERSONA_STAGING_MONGO=""
