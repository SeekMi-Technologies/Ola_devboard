# Ola_devboard backend image (Ola/#225 dockerize).
# Read-only Express consumer of CRM telemetry. Binds 0.0.0.0 inside the
# container; only reachable via the frontend nginx proxy on the compose
# network (no published port). version.json is injected from build args so
# /api/version reports the real commit without shipping .git into the image.

FROM node:20-slim AS deps
WORKDIR /app/backend
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

FROM node:20-slim
WORKDIR /app/backend
ENV NODE_ENV=production

COPY --from=deps /app/backend/node_modules ./node_modules
COPY . .

# version.json — generated by scripts/build_version.sh on bare-metal, but in
# the image there is no .git, so the build helper passes git metadata as args.
# Falls back to "unknown" (matches version.js FALLBACK) when built without args.
ARG GIT_REV=unknown
ARG GIT_SHA=unknown
ARG GIT_SHA_SHORT=unknown
ARG GIT_BRANCH=unknown
ARG BUILT_AT=unknown
RUN printf '{\n  "rev": "%s",\n  "sha": "%s",\n  "shaShort": "%s",\n  "branch": "%s",\n  "tag": null,\n  "builtAt": "%s"\n}\n' \
      "$GIT_REV" "$GIT_SHA" "$GIT_SHA_SHORT" "$GIT_BRANCH" "$BUILT_AT" \
      > src/version.json

EXPOSE 8890
CMD ["node", "src/server.js"]
